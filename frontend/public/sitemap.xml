<?xml version="1.0" encoding="UTF-8"?>
<!--
  LOT M1 — le site n'avait AUCUN sitemap : /sitemap.xml tombait sur le
  catch-all SPA et renvoyait du HTML. Ce fichier vit dans `public/`, donc il est
  copie tel quel dans le build et servi en XML par le serveur de fichiers
  statiques, sans passer par le catch-all.

  Il ne liste que des pages REELLES et indexables. Pas de `lastmod` : une date
  figee dans un fichier statique vieillit et ment plus vite qu'elle n'aide.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://afroboost.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://afroboost.com/cours-essai-gratuit-neuchatel</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <!-- SEO-GEO (19/10/2026) : page « À propos », écrite par le serveur, lisible sans JavaScript. -->
  <url>
    <loc>https://afroboost.com/a-propos</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <!--
    SEO-5 (10/11/2026) — « Politique de confidentialité ». Elle manquait, et
    c'est la SEULE qui manquait. Elle est écrite par le serveur (route déclarée
    très en amont du catch-all, texte lu dans `api/static_pages/`), lisible sans
    JavaScript, et elle s'annonce `index, follow`.

    POURQUOI LA LISTE S'ARRÊTE LÀ. `/boutique`, `/offres`, `/partenaires`,
    `/contact`, `/blog` répondent 200 — mais elles renvoient `index.html` à
    l'octet près : ce sont des vues dessinées par React, pas des pages qui se
    présentent. Les ajouter répéterait l'erreur de SEO-4 (`/devenir-coach`) :
    annoncer à Google des adresses dont le contenu est identique à l'accueil.
    Le jour où l'une d'elles sera écrite par le serveur, elle entrera ici.
  -->
  <url>
    <loc>https://afroboost.com/confidentialite</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
